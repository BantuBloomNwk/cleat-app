    "@google/genai": "^2.4.0",
    "@netlify/blobs": "^10.7.13",
    "@noble/curves": "^1.8.1",
    "@solana-mobile/wallet-standard-mobile": "^0.6.0",
    "@solana/web3.js": "^1.99.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@wallet-standard/app": "^1.1.1",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
