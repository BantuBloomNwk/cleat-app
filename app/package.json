{
  "name": "cleat-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build && npm run build:functions && node scripts/ota-bundle.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
