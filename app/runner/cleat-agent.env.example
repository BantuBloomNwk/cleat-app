# Copy to /etc/cleat-agent.env, fill in, chmod 600. Never commit the real one.
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE
# The loop agent's secret key, the same JSON array Netlify holds.
CLEAT_LOOP_AGENT=[REPLACE]
# Where the paper books live, and the secret only the store endpoint knows.
CLEAT_STORE_URL=https://cleat-preview.netlify.app
CLEAT_RUNNER_SECRET=REPLACE
# Optional. Pyth is read first when this is set.
PYTH_API_KEY=
# A model on this machine (any OpenAI-compatible server, ending in /v1).
# When set, Gemini is never asked and nothing leaves the server.
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=qwen
# Only used when LOCAL_LLM_URL is empty.
GEMINI_API_KEY=
